// -------------- Views --------------
function HomeView({ goChat }){
  const [mood, setMood] = useState(() => store.get("mw_mood_today", null));
  const moods = [
    { id: 3, label: "Bien", icon: "😊" },
    { id: 2, label: "Moyen", icon: "😐" },
    { id: 1, label: "Mal", icon: "😔" },
  ];

  function saveMood(id){
    setMood(id);
    store.set("mw_mood_today", id);
    const log = store.get("mw_mood_log", []);
    const key = todayKey();
    const exists = log.find(x => x.date === key);
    if (exists) exists.value = id; else log.push({ date: key, value: id });
    store.set("mw_mood_log", log);
  }

  return (
    <section className="grid md:grid-cols-2 gap-6 mt-4">
      <Card className="rounded-2xl">
        <CardContent className="p-6">
          <h3 className="font-semibold text-lg">Comment vous sentez-vous aujourd’hui ?</h3>
          <div className="mt-4 grid grid-cols-3 gap-3">
            {moods.map(m => (
              <button key={m.id} onClick={() => saveMood(m.id)} className={`p-4 rounded-2xl border ${mood===m.id?"bg-sky-100 border-sky-300 dark:bg-sky-900/30 dark:border-sky-700":"border-slate-200 dark:border-slate-800"}`}>
                <div className="text-3xl">{m.icon}</div>
                <div className="mt-2 font-medium">{m.label}</div>
              </button>
            ))}
          </div>
        </CardContent>
      </Card>

      <Card className="rounded-2xl">
        <CardContent className="p-6">
          <h3 className="font-semibold text-lg">Raccourcis</h3>
          <div className="mt-4 flex flex-wrap gap-3">
            <Button onClick={goChat}>Parler au chatbot</Button>
            <Dialog>
              <DialogTrigger asChild><Button variant="outline">Respiration guidée</Button></DialogTrigger>
              <DialogContent>
                <DialogHeader><DialogTitle>Exercice : 4‑6 Respiration</DialogTitle></DialogHeader>
                <p>Inspirez 4 secondes — Expirez 6 secondes. Répétez 10 fois. Concentrez-vous sur l’air qui entre et sort.</p>
              </DialogContent>
            </Dialog>
            <Button variant="outline">Méditation 5 min</Button>
          </div>
        </CardContent>
      </Card>
    </section>
  );
}

function ChatView(){
  const [messages, setMessages] = useState(() => store.get("mw_chat", [
    { role: "assistant", text: "Bonjour, je suis là pour vous écouter. Que souhaitez‑vous partager aujourd’hui ?" }
  ]));
  const [input, setInput] = useState("");

  useEffect(() => { store.set("mw_chat", messages); }, [messages]);

  function reply(userText){
    const empathic = generateEmpathicReply(userText);
    setMessages(prev => [...prev, { role: "user", text: userText }, { role: "assistant", text: empathic }]);
  }

  return (
    <div className="mt-4 grid gap-4">
      <Card className="rounded-2xl">
        <CardContent className="p-4 md:p-6">
          <div className="space-y-3 max-h-[55vh] overflow-y-auto pr-1">
            {messages.map((m, i) => (
              <div key={i} className={`flex ${m.role==='user'?'justify-end':''}`}>
                <div className={`px-4 py-2 rounded-2xl max-w-[80%] ${m.role==='user'?'bg-sky-600 text-white':'bg-slate-100 dark:bg-slate-800'}`}>{m.text}</div>
              </div>
            ))}
          </div>
          <div className="mt-4 flex gap-2">
            <Input placeholder="Écrivez ici…" value={input} onChange={e=>setInput(e.target.value)} onKeyDown={e=>{ if(e.key==='Enter' && input.trim()) { reply(input.trim()); setInput(""); }}}/>
            <Button onClick={()=>{ if(input.trim()){ reply(input.trim()); setInput(""); }}}>Envoyer</Button>
          </div>
          <div className="mt-3 text-xs opacity-70">Réponses générées par règles simples (démo). En production : IA/NLP avec garde‑fous.</div>
        </CardContent>
      </Card>
    </div>
  );
}

function generateEmpathicReply(text){
  const lowers = text.toLowerCase();
  const suggestions = [];
  if (/(stress|angoisse|anxiété|anxiete)/.test(lowers)) suggestions.push("Essayons une respiration 4‑6 pendant 2 minutes. Souhaitez‑vous une guidance ?");
  if (/(triste|déprime|deprime|dépression|depression)/.test(lowers)) suggestions.push("Je suis désolé·e que ce soit si difficile. Noter 3 petites choses positives aujourd’hui peut aider. Voulez‑vous essayer ?");
  if (/(col[eè]re|furieux)/.test(lowers)) suggestions.push("La mise à distance peut aider : petite marche de 5 minutes, puis écrivez ce que vous ressentez.");
  if (/(dormi|sommeil|insomnie)/.test(lowers)) suggestions.push("Routine de coucher : écran off 30 min, respiration lente, lumière douce.");
  const base = "Merci de l’avoir partagé. Votre ressenti est important et valable. Je suis là pour vous écouter. ";
  const end = suggestions.length? suggestions[0] : "Souhaitez‑vous me dire depuis quand cela dure et ce qui vous aiderait maintenant ?";
  return base + end;
}

function AssessmentsView(){
  const [phq2, setPhq2] = useState(store.get("mw_phq2", [0,0]));
  const [gad2, setGad2] = useState(store.get("mw_gad2", [0,0]));
  const totalPhq = phq2.reduce((a,b)=>a+b,0);
  const totalGad = gad2.reduce((a,b)=>a+b,0);

  useEffect(()=>{ store.set("mw_phq2", phq2); }, [phq2]);
  useEffect(()=>{ store.set("mw_gad2", gad2); }, [gad2]);

  const scale = [
    {v:0,l:"Jamais"}, {v:1,l:"Plusieurs jours"}, {v:2,l:"> moitié des jours"}, {v:3,l:"Quasi tous les jours"}
  ];

  return (
    <div className="mt-4 grid md:grid-cols-2 gap-6">
      <Card className="rounded-2xl"><CardContent className="p-6">
        <h3 className="font-semibold text-lg mb-2">PHQ‑2 (humeur)</h3>
        <LikertQ q="Peu d’intérêt ou de plaisir à faire les choses" val={phq2[0]} set={v=>setPhq2([v, phq2[1]])} scale={scale} />
        <LikertQ q="Se sentir triste, déprimé·e ou sans espoir" val={phq2[1]} set={v=>setPhq2([phq2[0], v])} scale={scale} />
        <Summary score={totalPhq} threshold={3} name="PHQ‑2" />
      </CardContent></Card>

      <Card className="rounded-2xl"><CardContent className="p-6">
        <h3 className="font-semibold text-lg mb-2">GAD‑2 (anxiété)</h3>
        <LikertQ q="Se sentir nerveux·se, anxieux·se ou à vif" val={gad2[0]} set={v=>setGad2([v, gad2[1]])} scale={scale} />
        <LikertQ q="Ne pas pouvoir s’arrêter de s’inquiéter" val={gad2[1]} set={v=>setGad2([gad2[0], v])} scale={scale} />
        <Summary score={totalGad} threshold={3} name="GAD‑2" />
      </CardContent></Card>
    </div>
  );
}

function LikertQ({ q, val, set, scale }){
  return (
    <div className="mb-4">
      <div className="mb-2">{q}</div>
      <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {scale.map(s => (
          <Button key={s.v} variant={val===s.v?"default":"outline"} onClick={()=>set(s.v)} className="rounded-xl">{s.l}</Button>
        ))}
      </div>
    </div>
  );
}

function Summary({ score, threshold, name }){
  const flag = score >= threshold;
  return (
    <div className={`mt-3 p-3 rounded-xl ${flag?"bg-amber-100 text-amber-900 dark:bg-amber-900/20":"bg-emerald-100 text-emerald-900 dark:bg-emerald-900/20"}`}>
      Score {name} : <b>{score}</b> — {flag?"vos réponses suggèrent un inconfort notable. Envisagez d’en parler à un professionnel.":"rien d’inhabituel signalé. Continuez vos habitudes de bien‑être."}
    </div>
  );
}

