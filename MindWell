  const [consented, setConsented] = useState(() => store.get("mw_consented", false));
  const [dark, setDark] = useState(() => store.get("mw_dark", false));

  useEffect(() => { document.documentElement.classList.toggle("dark", dark); store.set("mw_dark", dark); }, [dark]);
  useEffect(() => { store.set("mw_consented", consented); }, [consented]);

  return (
    <div className="min-h-screen bg-gradient-to-b from-sky-50 to-white dark:from-slate-900 dark:to-slate-950 text-slate-900 dark:text-slate-100">
      <Header onToggleDark={() => setDark(!dark)} dark={dark} />

      <main className="max-w-5xl mx-auto p-4 md:p-8">
        <AnimatePresence mode="wait">
          {!consented && (
            <motion.div key="consent" initial={{opacity:0, y:10}} animate={{opacity:1, y:0}} exit={{opacity:0}}>
              <ConsentCard onAccept={() => setConsented(true)} />
            </motion.div>
          )}
        </AnimatePresence>

        <Tabs value={tab} onValueChange={setTab} className="mt-4">
          <TabsList className="grid grid-cols-6 gap-2 bg-white/60 dark:bg-slate-800/60 p-1 rounded-2xl">
            <TabsTrigger value="home" className="rounded-xl flex items-center gap-2"><Home className="h-4 w-4"/>Accueil</TabsTrigger>
            <TabsTrigger value="chat" className="rounded-xl flex items-center gap-2"><MessageCircle className="h-4 w-4"/>Chat</TabsTrigger>
            <TabsTrigger value="assess" className="rounded-xl flex items-center gap-2"><ShieldCheck className="h-4 w-4"/>Évaluation</TabsTrigger>
            <TabsTrigger value="resources" className="rounded-xl flex items-center gap-2"><BookOpen className="h-4 w-4"/>Ressources</TabsTrigger>
            <TabsTrigger value="progress" className="rounded-xl flex items-center gap-2"><PieChart className="h-4 w-4"/>Suivi</TabsTrigger>
            <TabsTrigger value="settings" className="rounded-xl flex items-center gap-2"><Settings className="h-4 w-4"/>Réglages</TabsTrigger>
          </TabsList>

          <TabsContent value="home"><HomeView goChat={() => setTab("chat")} /></TabsContent>
          <TabsContent value="chat"><ChatView /></TabsContent>
          <TabsContent value="assess"><AssessmentsView /></TabsContent>
          <TabsContent value="resources"><ResourcesView /></TabsContent>
          <TabsContent value="progress"><ProgressView /></TabsContent>
          <TabsContent value="settings"><SettingsView dark={dark} setDark={setDark} resetConsent={() => setConsented(false)} /></TabsContent>
