/**
 * MindWell — MVP Web Prototype (React + Tailwind + shadcn + Recharts)
 * --------------------------------------------------------------
 * This single-file prototype demonstrates the core flows:
 * - Onboarding + Consent
 * - Home (quick mood check, shortcuts)
 * - Chatbot (empathetic, non-clinical)
 * - Assessments (mini PHQ-2 / GAD-2)
 * - Resources Library (audio/text placeholders)
 * - Progress (mood history chart)
 * - Settings (privacy, data export/delete)
 *
 * Data is stored locally via localStorage (for demo only).
 * Important: This is NOT a medical device and does not replace professional care.
 */

// -------------- Utilities --------------
const store = {
  get(key, fallback) {
    try { return JSON.parse(localStorage.getItem(key) ?? "null") ?? fallback; } catch { return fallback; }
  },
  set(key, val) {
    localStorage.setItem(key, JSON.stringify(val));
  },
  del(key) { localStorage.removeItem(key); }
};

const todayKey = () => new Date().toISOString().slice(0,10);

