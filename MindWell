function ProgressView(){
  const data = useMemo(()=>{
    const log = store.get("mw_mood_log", []);
    return log
      .sort((a,b)=>a.date.localeCompare(b.date))
      .slice(-14)
      .map(x=>({ date: x.date.slice(5), mood: x.value }));
  }, [store.get("mw_mood_log", [])]);

  return (
    <div className="mt-4">
      <Card className="rounded-2xl">
        <CardContent className="p-6">
          <h3 className="font-semibold text-lg mb-2">Évolution de l’humeur (14 derniers jours)</h3>
          <div className="h-64">
            <ResponsiveContainer width="100%" height="100%">
              <LineChart data={data} margin={{ top: 5, right: 20, left: 0, bottom: 5 }}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="date" />
                <YAxis domain={[0,4]} ticks={[1,2,3]} />
                <Tooltip />
                <Line type="monotone" dataKey="mood" dot />
              </LineChart>
            </ResponsiveContainer>
          </div>
          <p className="text-xs opacity-70 mt-2">1 = mal, 2 = moyen, 3 = bien</p>
        </CardContent>
      </Card>
    </div>
  );
}

function SettingsView({ dark, setDark, resetConsent }){
  const [exported, setExported] = useState("");

  function exportData(){
    const payload = {
      moodLog: store.get("mw_mood_log", []),
      chat: store.get("mw_chat", []),
      phq2: store.get("mw_phq2", [0,0]),
      gad2: store.get("mw_gad2", [0,0])
    };
    const txt = JSON.stringify(payload, null, 2);
    setExported(txt);
  }

  function wipe(){
    store.del("mw_mood_log");
    store.del("mw_chat");
    store.del("mw_phq2");
    store.del("mw_gad2");
    store.del("mw_mood_today");
    setExported("");
    alert("Données locales supprimées.");
  }

  return (
    <div className="mt-4 grid md:grid-cols-2 gap-6">
      <Card className="rounded-2xl"><CardContent className="p-6 space-y-4">
        <h3 className="font-semibold text-lg">Affichage</h3>
        <div className="flex items-center justify-between">
          <span>Mode sombre</span>
          <Switch checked={dark} onCheckedChange={setDark} />
        </div>
        <h3 className="font-semibold text-lg mt-6">Confidentialité</h3>
        <div className="flex gap-2">
          <Button variant="outline" onClick={exportData}>Exporter mes données</Button>
          <Button variant="destructive" onClick={wipe}>Effacer mes données</Button>
        </div>
        <div className="flex gap-2">
          <Button variant="outline" onClick={resetConsent}>Revoir le consentement</Button>
        </div>
        <Textarea readOnly value={exported} placeholder="Vos données exportées apparaîtront ici…" className="min-h-[140px]"/>
      </CardContent></Card>

      <Card className="rounded-2xl"><CardContent className="p-6">
        <h3 className="font-semibold text-lg">Contact avec un pro (démo)</h3>
        <p className="opacity-80 text-sm">Cette section affichera prochainement des thérapeutes partenaires vérifiés, avec prise de rendez‑vous.</p>
        <div className="mt-3 grid grid-cols-2 gap-2">
          <Button variant="outline">Voir les partenaires</Button>
          <Button>Demander un rendez‑vous</Button>
        </div>
      </CardContent></Card>
    </div>
  );
}
